# Use `go-admin new` or `make setup`; generated secrets are unique per project.
APP_ENV=development
APP_NAME=GoAdmin Kit
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=8080
FRONTEND_PORT=3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=goadmin
POSTGRES_PASSWORD=
POSTGRES_DB=goadmin
POSTGRES_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONNECT_TIMEOUT=5s
HEALTH_TIMEOUT=2s
# Server-only. Never put database credentials or this URL in NEXT_PUBLIC_*.
API_INTERNAL_URL=http://127.0.0.1:8080

# Exact browser origins, not URLs with paths. Production requires HTTPS.
PUBLIC_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Empty means trust no proxy. Never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXIES=
# Production forces Secure; omit COOKIE_SECURE to derive it from APP_ENV.
COOKIE_SAME_SITE=lax
SESSION_TTL=12h
SESSION_IDLE_TTL=30m
CSRF_TTL=1h
# Required in production: independently generated secret, at least 32 bytes.
# Empty in development generates an ephemeral process secret.
CSRF_SECRET=
# Optional until a sensitive setting is registered. Base64 of exactly 32 random bytes;
# retain securely with backups and rotate through an explicit migration/key-version plan.
SETTINGS_ENCRYPTION_KEY=
# Local trusted plugin packages are read-only under <root>/<plugin-id>/<semver>/.
# Only signed manifest.json and checksum-pinned SQL migrations are accepted;
# no uploaded executable or script is loaded. Omit to disable package installation.
PLUGIN_PACKAGE_ROOT=
# Comma-separated base64 Ed25519 public keys (32 bytes each) from trusted publishers.
PLUGIN_TRUSTED_PUBLIC_KEYS=
# Required only when plugins declare secret config. Base64 of 32 random bytes.
# Retain securely: losing this key makes stored plugin secrets undecryptable.
PLUGIN_CONFIG_ENCRYPTION_KEY=
# Opt-in for host development; must be a private (0700) absolute directory.
# Compose mounts the separate media_data volume at /var/lib/goadmin/media. Set this
# path in .env only AFTER explicit admin media-bind against the confirmed database.
MEDIA_STORAGE_ROOT=
MEDIA_MIN_FREE_BYTES=134217728

# Existing-schema upgrades are deliberately blocked without all four values.
# Set only for an approved maintenance window after a restorable paired DB +
# Media volume backup has been verified; never leave these in a reusable .env.
# MIGRATION_CONFIRM_DATABASE must exactly equal POSTGRES_DB; FROM/TO must match
# the observed database version and binary's embedded latest migration.
MIGRATION_CONFIRM_DATABASE=
MIGRATION_CONFIRM_FROM_VERSION=
MIGRATION_CONFIRM_TO_VERSION=
MIGRATION_BACKUP_REFERENCE=
