      "Ready": {"allOf": [{"$ref": "#/components/schemas/Envelope"}, {"type": "object", "properties": {"code": {"type": "integer", "enum": [0]}, "data": {"type": "object", "required": ["status", "database", "migration", "checked_at"], "properties": {"status": {"type": "string", "enum": ["ok"]}, "database": {"type": "string", "enum": ["connected"]}, "migration": {"type": "string", "enum": ["current"]}, "checked_at": {"type": "string", "format": "date-time"}}}}}]},
      "Unavailable": {"type": "object", "required": ["code", "message", "data"], "properties": {"code": {"type": "integer", "enum": [50301]}, "message": {"type": "string", "enum": ["Service not ready"]}, "data": {"type": "object", "nullable": true, "enum": [null]}}}
    }
  }
