    "/api/v1/health/live": {"get": {"tags": ["Health"], "operationId": "liveness", "summary": "Process liveness, independent of database", "responses": {"200": {"description": "Process alive", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Envelope"}, {"type": "object", "properties": {"data": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["ok"]}}}}}]}}}}}}},
    "/api/v1/health/ready": {"get": {"tags": ["Health"], "operationId": "readiness", "summary": "Database and migration readiness", "responses": {"200": {"$ref": "#/components/responses/Ready"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/openapi.json": {"get": {"operationId": "openapi", "summary": "OpenAPI document (not an API envelope)", "responses": {"200": {"description": "OpenAPI 3.0.3 JSON document", "content": {"application/json": {"schema": {"type": "object"}}}}}}}
  },
  "components": {
    "parameters": {"CSRF": {"name": "X-CSRF-Token", "in": "header", "required": true, "schema": {"type": "string"}, "description": "Matches the signed HttpOnly CSRF cookie and the allowed Origin"}, "ArticleID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "PluginID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"}}, "PluginRouteKey": {"name": "key", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,47}$"}}},
    "responses": {
