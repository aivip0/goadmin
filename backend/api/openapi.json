    "/api/v1/auth/logout-all": {"post": {"tags": ["Auth"], "operationId": "logoutAll", "summary": "Revoke all sessions for the authenticated administrator", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "All sessions revoked"}, "401": {"description": "No valid session"}, "403": {"description": "CSRF validation failed"}}}},
