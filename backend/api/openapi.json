      "ArticleCategoryInput": {"type": "object", "additionalProperties": false, "required": ["name", "slug", "description", "status"], "properties": {"name": {"type": "string", "maxLength": 120}, "slug": {"type": "string", "maxLength": 120, "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"}, "description": {"type": "string", "maxLength": 2000}, "status": {"type": "string", "enum": ["active", "disabled"]}}},
      "AdminUser": {"type": "object", "required": ["id", "username", "email", "display_name"], "properties": {"id": {"type": "string", "format": "uuid"}, "username": {"type": "string"}, "email": {"type": "string", "format": "email"}, "display_name": {"type": "string"}}},
