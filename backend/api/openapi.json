{
  "openapi": "3.0.3",
  "info": {"title": "GoAdmin Kit API", "version": "0.4.0", "description": "Generic administration, scoped API keys, notifications and persistent jobs."},
  "servers": [{"url": "/"}],
  "tags": [{"name": "Health"}, {"name": "Security"}, {"name": "Auth"}, {"name": "Profile"}, {"name": "Dashboard"}, {"name": "Settings"}, {"name": "Media"}, {"name": "Logs"}, {"name": "Articles"}, {"name": "Notifications"}, {"name": "API Keys"}, {"name": "Jobs"}, {"name": "Plugins"}],
  "paths": {
    "/api/v1/admin/plugins": {"get": {"tags": ["Plugins"], "summary": "List installed plugins; plugins:view", "responses": {"200": {"description": "Installed plugin metadata"}, "401": {"description": "Session required"}, "403": {"description": "Permission denied"}}}},
    "/api/v1/admin/plugins/packages": {"get": {"tags": ["Plugins"], "summary": "List locally available signed packages; plugins:view", "responses": {"200": {"description": "Verified local packages only"}}}},
    "/api/v1/admin/plugins/events": {"get": {"tags": ["Plugins"], "summary": "List bounded lifecycle events; plugins:view", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}, {"name": "plugin_id", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Recent plugin events"}}}},
    "/api/v1/admin/plugins/install": {"post": {"tags": ["Plugins"], "summary": "Install a locally staged signed package; plugins:install", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"}, "version": {"type": "string"}}}}}}, "responses": {"200": {"description": "Installed verified package"}, "409": {"description": "Package or dependency conflict"}}}},
    "/api/v1/admin/plugins/{id}/config": {"get": {"tags": ["Plugins"], "summary": "Read plugin configuration with secrets redacted; plugins:view", "parameters": [{"$ref": "#/components/parameters/PluginID"}], "responses": {"200": {"description": "Declared config fields; secret values are omitted"}}}, "put": {"tags": ["Plugins"], "summary": "Update plugin configuration; plugins:configure", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["values"], "properties": {"values": {"type": "object"}}}}}}, "responses": {"200": {"description": "Saved config; secret values remain redacted"}}}},
    "/api/v1/admin/plugins/{id}/enable": {"post": {"tags": ["Plugins"], "summary": "Enable plugin and menus; plugins:enable", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Enabled"}, "409": {"description": "Dependency or state conflict"}}}},
    "/api/v1/admin/plugins/{id}/disable": {"post": {"tags": ["Plugins"], "summary": "Disable plugin and hide menus; plugins:disable", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Disabled"}, "409": {"description": "Enabled dependents or state conflict"}}}},
    "/api/v1/admin/plugins/{id}/upgrade": {"post": {"tags": ["Plugins"], "summary": "Upgrade disabled plugin using signed migrations; plugins:migrate", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Upgraded atomically"}, "409": {"description": "Version or migration conflict"}}}},
    "/api/v1/admin/plugins/{id}/uninstall": {"post": {"tags": ["Plugins"], "summary": "Uninstall disabled plugin without reversing its DDL; plugins:uninstall", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Uninstalled; event history retained"}, "409": {"description": "Plugin must be disabled"}}}},
    "/api/v1/admin/plugins/{id}/routes/{key}": {"get": {"tags": ["Plugins"], "summary": "Call manifest route through a build-time provider and live route permission", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/PluginRouteKey"}], "responses": {"200": {"description": "Provider response"}, "403": {"description": "Manifest permission denied"}}}, "post": {"tags": ["Plugins"], "summary": "Call JSON plugin route with live permission", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/PluginRouteKey"}, {"$ref": "#/components/parameters/CSRF"}], "requestBody": {"content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Provider response"}}}, "put": {"tags": ["Plugins"], "summary": "Update plugin route data with live permission", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/PluginRouteKey"}, {"$ref": "#/components/parameters/CSRF"}], "requestBody": {"content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Provider response"}}}, "delete": {"tags": ["Plugins"], "summary": "Delete plugin route data with live permission", "parameters": [{"$ref": "#/components/parameters/PluginID"}, {"$ref": "#/components/parameters/PluginRouteKey"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Provider response"}}}},
    "/api/v1/admin/notifications": {
      "get": {"tags": ["Notifications"], "summary": "List own notifications, bounded pagination; notifications:view", "responses": {"200": {"description": "Items, total, unread count, pagination"}, "401": {"description": "Session required"}, "403": {"description": "Permission denied"}}},
      "post": {"tags": ["Notifications"], "summary": "Send a notification to an active administrator; notifications:create", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["recipient_id","title","body"], "properties": {"recipient_id": {"type": "string", "format": "uuid"}, "title": {"type": "string", "maxLength": 160}, "body": {"type": "string", "maxLength": 4000}}}}}}, "responses": {"200": {"description": "Notification"}, "422": {"description": "Recipient is not active"}}}
    },
    "/api/v1/admin/notifications/{id}/read": {"post": {"tags": ["Notifications"], "summary": "Mark own notification read; notifications:view", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Notification"}, "404": {"description": "Notification not owned or absent"}}}},
    "/api/v1/admin/api-keys": {
      "get": {"tags": ["API Keys"], "summary": "List own key metadata only; api_keys:view", "responses": {"200": {"description": "Paginated keys; raw tokens never listed"}}},
      "post": {"tags": ["API Keys"], "summary": "Issue dashboard:view key, expires in 1–90 days; api_keys:create", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["name","expires_in_days"], "properties": {"name": {"type": "string", "maxLength": 100}, "expires_in_days": {"type": "integer", "minimum": 1, "maximum": 90}}}}}}, "responses": {"200": {"description": "Key metadata and one-time token; only SHA-256 is stored"}}}
    },
    "/api/v1/admin/api-keys/{id}/revoke": {"post": {"tags": ["API Keys"], "summary": "Revoke own key immediately; api_keys:revoke", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Revoked"}, "404": {"description": "Not owned or absent"}}}},
    "/api/v1/key/dashboard/summary": {"get": {"tags": ["API Keys"], "summary": "Direct Go API only, Authorization: Bearer gak_...; key scope and live owner dashboard:view required; not proxied by Next", "responses": {"200": {"description": "Real dashboard summary"}, "401": {"description": "Invalid, expired, revoked key or inactive owner"}, "403": {"description": "Owner permission revoked"}}}},
    "/api/v1/admin/jobs": {
      "get": {"tags": ["Jobs"], "summary": "List persisted tasks with bounded pagination; jobs:view", "responses": {"200": {"description": "Paginated jobs"}}},
      "post": {"tags": ["Jobs"], "summary": "Queue session_cleanup only; jobs:create", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "enum": ["session_cleanup"]}}}}}}, "responses": {"200": {"description": "Queued job"}}}
    },
    "/api/v1/admin/jobs/{id}": {"get": {"tags": ["Jobs"], "summary": "Task and execution history; jobs:view", "parameters": [{"$ref": "#/components/parameters/ArticleID"}], "responses": {"200": {"description": "Job with runs"}, "404": {"description": "Not found"}}}},
    "/api/v1/admin/jobs/{id}/retry": {"post": {"tags": ["Jobs"], "summary": "Queue one new attempt from a failed job; jobs:retry", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "New job referencing the failed job"}, "409": {"description": "Already retried or not failed"}}}},
    "/api/v1/admin/articles": {
      "get": {"tags": ["Articles"], "operationId": "listArticles", "summary": "List articles with bounded search and pagination; requires articles:view", "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}, {"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 100}}, {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["draft", "published"]}}, {"name": "category_id", "in": "query", "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Envelope with items, total, page and page_size"}, "401": {"description": "Session required"}, "403": {"description": "Permission denied"}}},
      "post": {"tags": ["Articles"], "operationId": "createArticle", "summary": "Create draft; requires articles:create and CSRF", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArticleInput"}}}}, "responses": {"200": {"description": "Created draft"}, "409": {"description": "Duplicate slug"}, "422": {"description": "Invalid category reference"}}}
    },
    "/api/v1/admin/articles/{id}": {
      "get": {"tags": ["Articles"], "operationId": "getArticle", "summary": "Read article; requires articles:view", "parameters": [{"$ref": "#/components/parameters/ArticleID"}], "responses": {"200": {"description": "Article"}, "404": {"description": "Not found"}}},
      "put": {"tags": ["Articles"], "operationId": "updateArticle", "summary": "Edit fields; requires articles:update and CSRF", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArticleInput"}}}}, "responses": {"200": {"description": "Updated article"}, "409": {"description": "Duplicate slug"}}},
      "delete": {"tags": ["Articles"], "operationId": "deleteDraft", "summary": "Delete draft; requires articles:delete and CSRF", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Deleted"}, "422": {"description": "Published article must be unpublished first"}}}
    },
    "/api/v1/admin/articles/{id}/publish": {"post": {"tags": ["Articles"], "operationId": "publishArticle", "summary": "Draft to published; requires articles:publish and CSRF", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Published article with UTC published_at"}, "422": {"description": "Invalid transition"}}}},
    "/api/v1/admin/articles/{id}/unpublish": {"post": {"tags": ["Articles"], "operationId": "unpublishArticle", "summary": "Published to draft; requires articles:publish and CSRF", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Draft with null published_at"}, "422": {"description": "Invalid transition"}}}},
    "/api/v1/admin/article-categories": {
      "get": {"tags": ["Articles"], "operationId": "listArticleCategories", "summary": "List categories; requires article_categories:view", "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "Category page"}}},
      "post": {"tags": ["Articles"], "operationId": "createArticleCategory", "summary": "Create category; requires article_categories:create and CSRF", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArticleCategoryInput"}}}}, "responses": {"200": {"description": "Created category"}, "409": {"description": "Duplicate slug"}}}
    },
    "/api/v1/admin/article-categories/{id}": {
      "put": {"tags": ["Articles"], "operationId": "updateArticleCategory", "summary": "Edit category; requires article_categories:update and CSRF", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArticleCategoryInput"}}}}, "responses": {"200": {"description": "Updated category"}, "409": {"description": "Duplicate slug"}}},
      "delete": {"tags": ["Articles"], "operationId": "deleteArticleCategory", "summary": "Delete unreferenced category; requires article_categories:delete and CSRF", "parameters": [{"$ref": "#/components/parameters/ArticleID"}, {"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Deleted"}, "409": {"description": "Category in use"}}}
    },
    "/api/v1/admin/profile": {
      "get": {"tags": ["Profile"], "operationId": "ownProfile", "summary": "Read own administrator profile", "responses": {"200": {"$ref": "#/components/responses/Admin"}, "401": {"description": "Session invalid"}}},
      "put": {"tags": ["Profile"], "operationId": "updateOwnProfile", "summary": "Update own display name and email", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["email", "display_name"], "properties": {"email": {"type": "string", "format": "email", "maxLength": 254}, "display_name": {"type": "string", "maxLength": 128}}}}}}, "responses": {"200": {"$ref": "#/components/responses/Admin"}, "400": {"description": "Invalid input"}, "401": {"description": "Session invalid"}, "403": {"description": "CSRF denied"}, "409": {"description": "Email already in use"}}}
    },
    "/api/v1/admin/profile/password": {"put": {"tags": ["Profile"], "operationId": "changeOwnPassword", "summary": "Verify current password and revoke all sessions after password change", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["current_password", "new_password"], "properties": {"current_password": {"type": "string", "format": "password"}, "new_password": {"type": "string", "format": "password", "minLength": 15}}}}}}, "responses": {"200": {"description": "Password changed; session cookie expired"}, "400": {"description": "Invalid input"}, "401": {"description": "Session invalid"}, "403": {"description": "CSRF denied"}, "422": {"description": "Current password incorrect"}, "429": {"description": "Persistent reauthentication rate limit"}}}},
    "/api/v1/admin/profile/sessions": {"get": {"tags": ["Profile"], "operationId": "listOwnSessions", "summary": "List only own active sessions", "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "Envelope with session items,total,page,page_size (ID and timestamps only)"}, "400": {"description": "Invalid pagination"}, "401": {"description": "Session invalid"}}}},
    "/api/v1/admin/profile/sessions/revoke-others": {"post": {"tags": ["Profile"], "operationId": "revokeOtherSessions", "summary": "Revoke all own sessions except current", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Other sessions revoked"}, "401": {"description": "Session invalid"}, "403": {"description": "CSRF denied"}}}},
    "/api/v1/admin/profile/sessions/{id}": {"delete": {"tags": ["Profile"], "operationId": "revokeOwnSession", "summary": "Revoke selected own session; expire cookie if current", "parameters": [{"$ref": "#/components/parameters/CSRF"}, {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Envelope with current_revoked boolean"}, "400": {"description": "Invalid ID"}, "401": {"description": "Session invalid"}, "403": {"description": "CSRF denied"}, "404": {"description": "Unknown or foreign session"}}}},
    "/api/v1/admin/audit-logs": {"get": {"tags": ["Logs"], "operationId": "listAuditLogs", "summary": "List operation history", "description": "Requires audit:view; UTC inclusive from/to dates, 30-day default window, at most 366 days. Sort by created_at DESC,id DESC. Response is the standard envelope with items,total,page,page_size.", "parameters": [{"name": "from", "in": "query", "schema": {"type": "string", "format": "date"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date"}}, {"name": "user_id", "in": "query", "schema": {"type": "string", "format": "uuid"}}, {"name": "action", "in": "query", "schema": {"type": "string"}}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "Redacted log page"}, "400": {"description": "Invalid filter"}, "401": {"description": "Authentication required"}, "403": {"description": "audit:view denied"}}}},
    "/api/v1/admin/audit-logs/{id}": {"get": {"tags": ["Logs"], "operationId": "auditLogDetail", "summary": "Read redacted operation event", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Log detail"}, "403": {"description": "audit:view denied"}, "404": {"description": "Not found"}}}},
    "/api/v1/admin/login-logs": {"get": {"tags": ["Logs"], "operationId": "listLoginLogs", "summary": "List classified login outcomes", "description": "Requires login_logs:view; no raw account identifier or credential is retained.", "parameters": [{"name": "from", "in": "query", "schema": {"type": "string", "format": "date"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date"}}, {"name": "user_id", "in": "query", "schema": {"type": "string", "format": "uuid"}}, {"name": "outcome", "in": "query", "schema": {"type": "string", "enum": ["success", "failure", "rate_limited"]}}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "Redacted log page"}, "400": {"description": "Invalid filter"}, "401": {"description": "Authentication required"}, "403": {"description": "login_logs:view denied"}}}},
    "/api/v1/admin/login-logs/{id}": {"get": {"tags": ["Logs"], "operationId": "loginLogDetail", "summary": "Read classified login event", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Log detail"}, "403": {"description": "login_logs:view denied"}, "404": {"description": "Not found"}}}},
    "/api/v1/admin/media": {
      "get": {"tags": ["Media"], "operationId": "listMedia", "summary": "List verified private media", "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}}, {"name": "type", "in": "query", "schema": {"type": "string", "enum": ["image", "document"]}}, {"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 80}}], "responses": {"200": {"description": "Envelope with verified items, total and pagination"}, "400": {"description": "Invalid filter"}, "401": {"description": "Authentication required"}, "403": {"description": "media:view denied"}, "503": {"description": "Media verification gate closed"}}},
      "post": {"tags": ["Media"], "operationId": "uploadMedia", "summary": "Stream a private media file", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["file"], "properties": {"file": {"type": "string", "format": "binary"}}}}}}, "responses": {"200": {"description": "Envelope with media metadata"}, "400": {"description": "Invalid multipart"}, "401": {"description": "Authentication required"}, "403": {"description": "CSRF or media:upload denied"}, "413": {"description": "Over 10 MiB image, 25 MiB file, or 26 MiB multipart"}, "415": {"description": "Unsupported file type"}, "422": {"description": "Invalid content"}, "503": {"description": "Storage unavailable"}}}
    },
    "/api/v1/admin/media/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "get": {"tags": ["Media"], "operationId": "getMedia", "summary": "Read verified private media metadata", "responses": {"200": {"description": "Envelope with media metadata"}, "401": {"description": "Authentication required"}, "403": {"description": "media:view denied"}, "404": {"description": "Not found"}}},
      "delete": {"tags": ["Media"], "operationId": "deleteMedia", "summary": "Delete unreferenced private media and retain tombstone", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "responses": {"200": {"description": "Deleted"}, "403": {"description": "CSRF or media:delete denied"}, "404": {"description": "Already deleted or absent"}, "409": {"description": "Referenced as Logo or concurrent mutation"}, "503": {"description": "Storage failure; maintenance can retry"}}}
    },
    "/api/v1/admin/media/{id}/content": {"get": {"tags": ["Media"], "operationId": "mediaContent", "summary": "Stream verified image preview or private attachment", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"name": "download", "in": "query", "schema": {"type": "string", "enum": ["1"]}}], "responses": {"200": {"description": "Verified image inline, other types attachment; nosniff and sandbox CSP", "content": {"image/png": {"schema": {"type": "string", "format": "binary"}}, "image/jpeg": {"schema": {"type": "string", "format": "binary"}}, "image/webp": {"schema": {"type": "string", "format": "binary"}}, "application/pdf": {"schema": {"type": "string", "format": "binary"}}, "text/plain": {"schema": {"type": "string", "format": "binary"}}}}, "403": {"description": "media:view denied"}, "404": {"description": "Not found"}, "416": {"description": "Range unsupported"}, "503": {"description": "Verification failure"}}}},
    "/api/v1/admin/dashboard/summary": {"get": {"tags": ["Dashboard"], "operationId": "dashboardSummary", "summary": "Administrator, role, security and login event totals; safe service status", "description": "Requires an active administrator session and dashboard:view. No infrastructure details are disclosed.", "responses": {"200": {"description": "Standard envelope with administrator/role/security counts, login_successes, login_failures and ready/unavailable service"}, "401": {"description": "Authentication required"}, "403": {"description": "Permission denied"}, "503": {"description": "Database unavailable"}}}},
    "/api/v1/admin/dashboard/activity": {"get": {"tags": ["Dashboard"], "operationId": "dashboardActivity", "summary": "Paginated recent security events", "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}}], "responses": {"200": {"description": "Standard envelope with items, total, page, page_size"}, "400": {"description": "Invalid pagination"}, "401": {"description": "Authentication required"}, "403": {"description": "Permission denied"}}}},
    "/api/v1/admin/dashboard/trends": {"get": {"tags": ["Dashboard"], "operationId": "dashboardTrends", "summary": "Security events grouped by UTC day", "parameters": [{"name": "range", "in": "query", "required": true, "schema": {"type": "string", "enum": ["7d", "30d"]}}], "responses": {"200": {"description": "Standard envelope with range and one point for each UTC date including today"}, "400": {"description": "Invalid range"}, "401": {"description": "Authentication required"}, "403": {"description": "Permission denied"}}}},
    "/api/v1/admin/settings": {
      "get": {"tags": ["Settings"], "operationId": "readSettings", "summary": "Read allowlisted system settings and defaults", "description": "Requires active Session and settings:view; sensitive values, if registered later, are redacted with configured status.", "responses": {"200": {"description": "Standard envelope data.settings keyed by allowlisted setting names; each entry has value when public, sensitive and configured flags"}, "401": {"description": "Authentication required"}, "403": {"description": "Permission denied"}, "503": {"description": "Storage or encryption key unavailable"}}},
      "put": {"tags": ["Settings"], "operationId": "updateSettings", "summary": "Atomically update allowlisted settings with audit records", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["settings"], "additionalProperties": false, "properties": {"settings": {"type": "object", "description": "Nonempty subset of registered keys only. Values validated by type and bounds.", "additionalProperties": true}}}}}}, "responses": {"200": {"description": "Same redacted representation as GET"}, "400": {"description": "Malformed JSON"}, "401": {"description": "Authentication required"}, "403": {"description": "CSRF invalid or settings:update denied"}, "422": {"description": "Unknown key or invalid value"}, "503": {"description": "Storage unavailable"}}}
    },
    "/api/v1/auth/csrf": {"get": {"tags": ["Security"], "operationId": "issueCSRF", "summary": "Issue a signed, session-bound CSRF token and HttpOnly cookie", "description": "Same-origin only. Keep the returned token in memory and send X-CSRF-Token plus browser cookies and an allowed Origin on business mutations. Obtain a new token after login/logout.", "responses": {"200": {"description": "CSRF token issued; non-cacheable", "headers": {"Set-Cookie": {"schema": {"type": "string"}}, "X-Request-ID": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"type": "object", "required": ["code", "message", "data"], "properties": {"code": {"type": "integer", "enum": [0]}, "message": {"type": "string"}, "data": {"type": "object", "required": ["csrf_token", "expires_in"], "properties": {"csrf_token": {"type": "string"}, "expires_in": {"type": "integer", "minimum": 60}}}}}}}}, "403": {"description": "Invalid Origin or cross-site request; code 40301"}, "500": {"description": "Internal error; no private details"}}}},
    "/api/v1/auth/login": {"post": {"tags": ["Auth"], "operationId": "login", "summary": "Verify credentials and create database session", "parameters": [{"$ref": "#/components/parameters/CSRF"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password"}}}}}}, "responses": {"200": {"$ref": "#/components/responses/Admin"}, "400": {"description": "Invalid input"}, "401": {"description": "Invalid username or password; code 40101"}, "403": {"description": "CSRF validation failed"}, "429": {"description": "Persistent login limit; Retry-After header"}, "503": {"description": "Database unavailable"}}}},
    "/api/v1/auth/me": {"get": {"tags": ["Auth"], "operationId": "currentAdmin", "summary": "Verify active database session", "responses": {"200": {"$ref": "#/components/responses/Admin"}, "401": {"description": "No valid session; code 40100"}, "503": {"description": "Database unavailable"}}}},
